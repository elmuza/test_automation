{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "$defs": {
        "address": {
            "type": "object",
            "properties": {
                "city": {
                    "type":"string",
                    "minLength": 2,
                    "maxLength": 100
                },
                "street": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 200
                },
                "postal_code": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 4
                }
            },
             "required": ["city", "street", "postal_code"],
             "additionalProperties": false
        }
    
    },
    "properties": {
        "id": {
            "type": "integer",
            "minimum": 0
        },
        "delivery_address": {
            "$ref": "#/$defs/address"
        },
         "billing_address": {
             "$ref": "#/$defs/address"
         }
    },
    "required": ["id", "delivery_address", "billing_address"],
    "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "name": {
      "type": "string"
    },
    "price": {
      "type": "integer"
    }
  },
  "required": ["id", "name", "price"],
  "additionalProperties": false
}